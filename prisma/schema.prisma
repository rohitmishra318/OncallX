// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  teamId       String
  role         Role
  createdAt    DateTime @default(now())

  team           Team            @relation(fields: [teamId], references: [id])
  monitorTargets MonitorTarget[]
}

enum Role {
  ADMIN
  RESPONDER
  VIEWER
}

model Team {
  id              String    @id @default(uuid())
  name            String
  slackWebhookUrl String?
  publicSlug      String?   @unique
  services        Service[]
  users           User[]
}

model CheckResult {
  id         String   @id @default(uuid())
  targetId   String   // maps to target.name in apps/monitor/targets.json
  timestamp  DateTime @default(now())
  success    Boolean
  statusCode Int?
  latencyMs  Int?

  @@index([targetId, timestamp])
}

model CheckResultHourly {
  id            String   @id @default(uuid())
  targetId      String
  hourBucket    DateTime // truncated to the hour (e.g. 2024-01-15T14:00:00Z)
  uptimePercent Float
  avgLatencyMs  Float
  p95LatencyMs  Float
  totalChecks   Int
  failedChecks  Int

  @@unique([targetId, hourBucket])
  @@index([targetId, hourBucket])
}

model MaintenanceWindow {
  id          String   @id @default(uuid())
  targetId    String
  startsAt    DateTime
  endsAt      DateTime
  reason      String?
  createdById String
  createdAt   DateTime @default(now())
}

model Service {
  id                 String  @id @default(uuid())
  name               String
  teamId             String
  apiKey             String  @unique @default(uuid())
  escalationPolicyId String?

  team             Team              @relation(fields: [teamId], references: [id])
  escalationPolicy EscalationPolicy?
  incidents        Incident[]
  monitorTargets   MonitorTarget[]
}

model EscalationPolicy {
  id               String  @id @default(uuid())
  serviceId        String  @unique
  primaryUserId    String
  fallbackUserId   String
  escalateAfterMin Int     @default(5)

  service Service @relation(fields: [serviceId], references: [id])
}

model Incident {
  id         String         @id @default(uuid())
  serviceId  String
  dedupKey   String
  status     IncidentStatus @default(OPEN)
  severity   Severity
  title      String         @default("")
  createdAt  DateTime       @default(now())
  ackedAt    DateTime?
  ackedById  String?
  resolvedAt DateTime?

  service       Service         @relation(fields: [serviceId], references: [id])
  events        IncidentEvent[]
  notifications Notification[]

  @@index([serviceId, dedupKey, status])
}

enum IncidentStatus {
  OPEN
  ACKED
  RESOLVED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model IncidentEvent {
  id         String   @id @default(uuid())
  incidentId String
  eventType  String // e.g. "created", "acked", "escalated", "resolved", "duplicate_alert"
  actorId    String?
  createdAt  DateTime @default(now())
  metadata   Json?

  incident Incident @relation(fields: [incidentId], references: [id])
}

model Notification {
  id           String   @id @default(uuid())
  incidentId   String
  channel      String // "email" | "slack"  — kept as plain string for Phase 2 extensibility
  status       String // "pending" | "sent" | "failed"
  attemptCount Int      @default(0)
  createdAt    DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id])
}

// ─── Phase 3: Dynamic Multi-Tenant Monitoring Targets ────────────────────────
// Replaces targets.json as the source of truth for what URLs apps/monitor checks.
// Each target belongs to a user and routes incidents through an existing Service.
model MonitorTarget {
  id                String   @id @default(uuid())
  userId            String
  serviceId         String   // incidents from this target use this Service's EscalationPolicy
  name              String
  url               String
  expectedStatus    Int      @default(200)
  timeoutMs         Int      @default(5000)
  intervalMs        Int      @default(60000)
  failureThreshold  Int      @default(3)
  successThreshold  Int      @default(2)
  degradedLatencyMs Int      @default(2000)
  apiKeyHash        String   // bcrypt hash — raw key shown once at creation, never stored
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])
}
